# issue: none
# notes: A match whose bindings share no edge pairs every row of one binding
# notes: with every row of the other. Each pair is charged to the query's
# notes: traversal_work_limit before it is evaluated, so a cross join over n
# notes: rows of a type is refused once n * n passes the limit, as an edge
# notes: selection is, instead of running quadratic work outside every
# notes: declared bound. Four people form 16 pairs.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    age: I64
}

--- seed
{"type":"Person","data":{"slug":"a","age":10}}
{"type":"Person","data":{"slug":"b","age":20}}
{"type":"Person","data":{"slug":"c","age":30}}
{"type":"Person","data":{"slug":"d","age":40}}

--- query
set traversal_work_limit = 15;
query pairs_refused() {
    match {
        $p: Person
        $q: Person
        $p.age > $q.age
    }
    return { $p.slug, $q.slug }
}

--- expect error: traversal_work_limit

--- query
set traversal_work_limit = 16;
query pairs_admitted() {
    match {
        $p: Person
        $q: Person
        $p.age > $q.age
    }
    return { $p.slug, $q.slug }
}

--- expect unordered
{"p.slug":"b","q.slug":"a"}
{"p.slug":"c","q.slug":"a"}
{"p.slug":"c","q.slug":"b"}
{"p.slug":"d","q.slug":"a"}
{"p.slug":"d","q.slug":"b"}
{"p.slug":"d","q.slug":"c"}

--- expect shape
p.slug: String
q.slug: String
